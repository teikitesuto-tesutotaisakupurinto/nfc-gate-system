rules_version = '2';

service cloud.firestore {

match /databases/{database}/documents {



/*
 利用者カード情報
*/

match /cards/{cardId} {


allow read:

if isStaff();


allow write:

if isOffice();


}





/*
 サービス一覧
*/

match /services/{serviceId} {


allow read:

if isStaff();


allow write:

if isAdmin();


}





/*
 契約利用履歴
*/

match /usage_logs/{logId} {


allow read:

if isStaff();


allow create:

if isServiceTerminal()
   || isOffice();


}





/*
 更新履歴
*/

match /renewal_logs/{logId} {


allow read:

if isStaff();


allow create:

if isOffice();


}





/*
 操作ログ
*/

match /operation_logs/{logId} {


allow read:

if isAdmin();


allow create:

if isStaff();


}





/*
 スタッフカード
*/

match /staff_cards/{staffId} {


allow read:

if isAdmin();


allow write:

if isAdmin();


}





/*
 端末管理
*/

match /devices/{deviceId} {


allow read:

if isStaff();


allow write:

if isAdmin();


}





/*
 カード読み取り通知
*/

match /card_scans/{scanId} {


allow create:

if isDevice();


allow read:

if isStaff();


}







/*
 権限判定
*/


function isStaff(){


return request.auth != null
&&
(
get(
/databases/$(database)/documents/staff_cards/$(request.auth.uid)
)
.data.status
==
"active"
);

}




function isAdmin(){


return isStaff()
&&
get(
/databases/$(database)/documents/staff_cards/$(request.auth.uid)
)
.data.role
==
"admin";

}





function isOffice(){


return isStaff()
&&
get(
/databases/$(database)/documents/staff_cards/$(request.auth.uid)
)
.data.role
in
["staff","admin"];

}




function isServiceTerminal(){


return request.auth != null
&&
get(
/databases/$(database)/documents/devices/$(request.auth.uid)
)
.data.type
==
"service";

}




function isDevice(){


return request.auth != null;

}



}

}
